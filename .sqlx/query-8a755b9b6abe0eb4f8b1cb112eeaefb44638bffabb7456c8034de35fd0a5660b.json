  "query": "\n        SELECT\n            c.id,\n            c.post_id,\n            c.user_id,\n            u.username,\n            u.display_name,\n            c.content,\n            c.status,\n            c.parent_id,\n            c.created_at,\n            c.updated_at\n        FROM comments c\n        JOIN users u ON u.id = c.user_id\n        WHERE c.post_id = ? AND c.status = 'approved'\n        ORDER BY c.created_at ASC\n        ",
