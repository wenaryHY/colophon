{
  "db_name": "SQLite",
  "query": "\n        SELECT\n            ak.id AS \"api_key_id!\",\n            ak.user_id as \"user_id!\",\n            u.username as \"username!\",\n            u.role as \"role!\",\n            ak.permissions as \"permissions!\",\n            ak.expires_at AS api_key_expires_at\n        FROM api_keys ak\n        JOIN users u ON u.id = ak.user_id\n        WHERE ak.key_hash = ?\n        LIMIT 1\n        ",
