{
  "db_name": "SQLite",
  "query": "\n        SELECT\n            t.id,\n            t.name,\n            t.slug,\n            t.created_at,\n            t.updated_at,\n            t.deleted_at\n        FROM tags t\n        JOIN post_tags pt ON pt.tag_id = t.id\n        WHERE pt.post_id = ? AND t.deleted_at IS NULL\n        ORDER BY t.name ASC\n        ",
