  "query": "\n        SELECT\n            c.id,\n            c.post_id,\n            COALESCE(u.display_name, u.username) AS author_name,\n            c.content,\n            c.status,\n            c.created_at\n        FROM comments c\n        JOIN users u ON u.id = c.user_id\n        WHERE c.id = ?\n        ",
