{
  "db_name": "SQLite",
  "query": "\n            SELECT\n                c.id,\n                c.post_id,\n                c.user_id,\n                u.username,\n                u.display_name,\n                c.content,\n                c.status,\n                c.parent_id,\n                c.created_at,\n                c.updated_at,\n                p.title AS post_title,\n                p.slug AS post_slug,\n                p.content_type AS \"post_content_type: ContentType\"\n            FROM comments c\n            JOIN users u ON u.id = c.user_id\n            JOIN posts p ON p.id = c.post_id\n            WHERE c.status != 'deleted'\n            ORDER BY c.created_at DESC\n            LIMIT ? OFFSET ?\n            ",
