# ============================================================
# 部署配置模板
# 复制此文件为 .env.deploy 并填写实际值
# cp .env.deploy.example .env.deploy
# ============================================================

# 服务器 IP 地址（必填）
DEPLOY_SERVER_IP=your-server-ip

# SSH 用户名（默认: root）
DEPLOY_SERVER_USER=root

# 服务器上的项目路径（默认: /opt/colophon）
DEPLOY_SERVER_PATH=/opt/colophon

# SSH 密钥路径（默认: ~/.ssh/id_ed25519）
DEPLOY_SSH_KEY_PATH=~/.ssh/id_ed25519

# 健康检查 URL（默认: http://127.0.0.1:2000/api/v1/health）
DEPLOY_HEALTH_CHECK_URL=http://127.0.0.1:2000/api/v1/health

# 本地项目路径（仅 scripts/deploy.sh 使用，WSL 路径格式）
# DEPLOY_LOCAL_PATH=/mnt/d/codes/colophon
